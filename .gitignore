# =============================================================================
# .gitignore for the omer/ (mph + spebt) research repo
# =============================================================================

# --- Virtual environments ---
.venv/
venv/

# --- Python bytecode / package artifacts ---
__pycache__/
*.py[cod]
*.so
*.egg-info/
.ipynb_checkpoints/

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Editor / IDE ---
.vscode/
.idea/
*.swp

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/

# --- Logs / HPC ---
*.log
**/slurm_logs/

# --- Heavy binary/data artifacts (blanket) ---
# Individual files that ARE tracked (e.g. spebt/data/sai_10mm/hot_rods_phantom_10.0_mm_x_10.0_mm.pt)
# stay tracked because git only auto-excludes NEW matches; existing tracked files are unaffected.
# Do NOT add such a file with `git add -f`.
*.pth
*.ckpt
*.h5
*.hdf5

# --- Per-config MOBO evaluation outputs — gigabytes each ---
# These are generated by run_sai_pipeline.sh into per-config directories
# under optimization/results/. Never commit them.
spebt/optimization/results/
spebt/optimization/plots/

# --- Generated analysis / presentation plots ---
spebt/plots/direction1/
spebt/plots/design_sensitivity_heatmap.png
spebt/plots/hypervolume_convergence.png
spebt/plots/key_tradeoffs.png
spebt/plots/metric_scatter_combined.png
spebt/plots/parallel_coordinates_combined.png
spebt/plots/pareto_expansion.png
spebt/plots/radar_comparison.png
spebt/plots/fig1_system_geometry.png

# --- CSV backups from backfill scripts (auto-generated timestamped copies) ---
*.bak.*.csv

# --- Local scratch / debugging files that shouldn't be committed ---
spebt/direction1_pipeline_figures.py
spebt/pymatcal/debug_*.py
spebt/pymatcal/test_subdivision_fix.py
spebt/pymatcal/subdivision_fix_validation.png
